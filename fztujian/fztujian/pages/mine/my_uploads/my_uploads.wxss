/**my_uploads.wxss - 我的上传统一样式**/
.container {
  padding: 20rpx;
  background: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  padding: 4rpx 4rpx;
  color: #111827;
}

.item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.item:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.cover {
  width: 200rpx;
  height: 160rpx;
  background: #f3f4f6;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  padding: 6rpx 4rpx 6rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.title-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.name {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
}

.status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-pending {
  background: #fffbeb;
  color: #b45309;
}

.status-approved {
  background: #ecfdf5;
  color: #047857;
}

.status-rejected {
  background: #fef2f2;
  color: #b91c1c;
}

.park {
  display: block;
  color: #6b7280;
  margin-top: 4rpx;
  font-size: 24rpx;
}

.time {
  display: block;
  color: #9ca3af;
  margin-top: 4rpx;
  font-size: 22rpx;
}

.desc {
  display: block;
  color: #6b7280;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.empty {
  color: #9ca3af;
  text-align: center;
  padding: 120rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
  line-height: 1.7;
}

.empty::before {
  content: "🐾\A";
  white-space: pre;
  font-size: 60rpx;
  opacity: 0.5;
}
