<view class="page">
  <view class="profile-card">
    <view class="profile-content">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="name-and-action">
        <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
      </view>
    </view>
  </view>

  <view class="list-card">
    <text class="list-title">常用功能</text>
    <view class="menu-item" bindtap="goUpload">
      <view class="left"><text class="icon">📤</text><text class="label">上传动物</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyUploads">
      <view class="left"><text class="icon">🗂</text><text class="label">我的上传列表</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <view class="left"><text class="icon">ℹ️</text><text class="label">关于我们</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item logout" bindtap="logout">
      <view class="left"><text class="icon">🚪</text><text class="label">退出登录</text></view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>