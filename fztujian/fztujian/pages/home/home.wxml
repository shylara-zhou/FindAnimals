<view class="container">
  <view class="header">
    <view class="header-top">
      <view class="header-text">
        <text class="title">福州动物图鉴</text>
        <text class="subtitle">发现身边的野生动物朋友 🐾</text>
      </view>
      <view class="login-entry" wx:if="{{!isLoggedIn}}" bindtap="goLogin">
        <text class="login-btn">登录</text>
      </view>
      <view class="user-info-entry" wx:else bindtap="goMine">
        <text class="user-name">{{userInfo.nickName}}</text>
      </view>
    </view>
  </view>

  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索动物（全局）" bindinput="onSearchInput" value="{{searchKeyword}}" confirm-type="search" bindconfirm="doGlobalSearch" />
    </view>
    <button class="search-btn" bindtap="doGlobalSearch">搜索</button>
  </view>

  <block wx:if="{{searchResults.length > 0}}">
    <view class="search-results">
      <view class="result-title">搜索结果</view>
      <block wx:for="{{searchResults}}" wx:key="id">
        <view class="result-card" bindtap="viewDetail" data-id="{{item.id}}">
          <image class="result-img" src="{{item.photo_url}}" mode="aspectFill"></image>
          <view class="result-info">
            <text class="result-name">{{item.name}}</text>
            <text class="result-park">📍 {{item.park_name}}</text>
          </view>
          <text class="result-arrow">›</text>
        </view>
      </block>
    </view>
  </block>

  <view class="section-head">
    <text class="section-title">探索公园</text>
    <text class="section-count">共 {{parks.length}} 个</text>
  </view>
  
  <view class="park-list">
    <block wx:for="{{parks}}" wx:key="id">
      <view class="park-card" bindtap="viewAnimals" data-id="{{item.id}}" data-name="{{item.name}}" data-cover="{{item.cover_url}}">
        <view class="park-img-wrap">
          <image class="park-cover" src="{{item.cover_url}}" mode="aspectFill"></image>
        </view>
        <view class="park-info">
          <text class="park-name">{{item.name}}</text>
          <text class="park-desc">{{item.description || '一起来探索这里的动物吧～'}}</text>
        </view>
        <view class="park-arrow-box">
          <text class="park-arrow">›</text>
        </view>
      </view>
    </block>
  </view>
</view>
