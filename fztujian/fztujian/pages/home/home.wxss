.container {
  padding: 20rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 16rpx 0 24rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-text {
  flex: 1;
}

.login-entry {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(22,163,74,0.25);
}

.login-btn {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.user-info-entry {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  border: 1rpx solid #e5e7eb;
}

.user-name {
  color: #374151;
  font-size: 26rpx;
  font-weight: 500;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #111827;
  display: block;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 10rpx;
  display: block;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  margin: 0 0 24rpx 0;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  margin: 0;
  min-height: 0;
  box-shadow: 0 4rpx 12rpx rgba(22,163,74,0.3);
}

.search-results {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 20rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.06);
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  padding: 8rpx 8rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
  margin-bottom: 8rpx;
}

.result-card {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.result-card:last-child {
  border-bottom: none;
}

.result-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.result-name {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.result-park {
  font-size: 24rpx;
  color: #9ca3af;
}

.result-arrow {
  color: #d1d5db;
  font-size: 40rpx;
  line-height: 1;
  margin-left: 10rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 4rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.section-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.park-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.park-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  transition: all 0.2s;
}

.park-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.park-img-wrap {
  width: 220rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.park-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.park-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  height: 140rpx;
  justify-content: center;
  overflow: hidden;
  padding-right: 12rpx;
}

.park-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 10rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.park-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.park-arrow-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.park-arrow {
  color: #9ca3af;
  font-size: 36rpx;
  line-height: 1;
  margin-left: 2rpx;
  margin-top: -2rpx;
}
