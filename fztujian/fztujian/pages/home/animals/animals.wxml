<view class="container">
  <view class="header">
    <view class="park-banner">
      <image class="banner-img" src="{{parkCover || '/images/default-park.png'}}" mode="aspectFill"></image>
      <view class="banner-mask"></view>
      <view class="banner-content">
        <text class="banner-title">{{parkName || '动物列表'}}</text>
        <text class="banner-sub">共 {{animals.length}} 种动物</text>
      </view>
    </view>
  </view>

  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索该公园动物" bindinput="onKeywordInput" value="{{keyword}}" confirm-type="search" bindconfirm="doSearch" />
    </view>
    <button class="search-btn" bindtap="doSearch">搜索</button>
  </view>

  <view class="animal-list">
    <block wx:for="{{animals}}" wx:key="id">
      <view class="animal-card" bindtap="viewDetail" data-id="{{item.id}}">
        <image class="animal-img" src="{{item.photo_url}}" mode="aspectFill"></image>
        <view class="animal-info">
          <view class="animal-top">
            <text class="animal-name">{{item.name}}</text>
            <text class="animal-views">🔥 {{item.views_count}}</text>
          </view>
          <text class="animal-park">📍 {{item.park_name}}</text>
          <text class="animal-desc">{{item.description}}</text>
        </view>
      </view>
    </block>
    <view class="empty-tip" wx:if="{{animals.length === 0}}">
      <text class="empty-icon">🐾</text>
      <text class="empty-text">这里还没有动物哦～</text>
    </view>
  </view>
</view>
