.container {
  padding: 20rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 0 0 20rpx;
}

.park-banner {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 55%, transparent 100%);
}

.banner-content {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
}

.banner-title {
  display: block;
  color: #fff;
  font-size: 42rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  margin-bottom: 8rpx;
}

.banner-sub {
  display: block;
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  margin: 0;
  min-height: 0;
  box-shadow: 0 4rpx 12rpx rgba(22,163,74,0.3);
}

.animal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.animal-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}

.animal-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.animal-img {
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.animal-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.animal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.animal-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 14rpx;
}

.animal-views {
  font-size: 24rpx;
  color: #ef4444;
  flex-shrink: 0;
  font-weight: 500;
}

.animal-park {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.animal-desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty-tip {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}
